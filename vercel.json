{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Permissions-Policy",
          "value": "autoplay=(self)"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Permissions-Policy",
          "value": "autoplay=(self)"
        }
      ]
    },
    {
      "source": "/(tv|dclf|dclf-lanzamiento|mantenimiento|wrapped|empezar|privacy)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Permissions-Policy",
          "value": "autoplay=(self)"
        }
      ]
    },
    {
      "source": "/(fonts|sounds|radio|icons|images|gallery|lasfotos|assets)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|woff2|ttf|ico|png|jpg|jpeg|webp|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/vc-api/:path*",
      "destination": "https://voice.yaire.site/:path*"
    },
    {
      "source": "/yt-search/piped/:path*",
      "destination": "https://pipedapi.kavin.rocks/:path*"
    },
    {
      "source": "/yt-search/inv/:path*",
      "destination": "https://inv.nadeko.net/api/v1/:path*"
    },
    {
      "source": "/__/:path*",
      "destination": "https://yaire-591ca.firebaseapp.com/__/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/((?!(?:api|vc-api|yt-search|__|\\.well-known)(?:/|$)|(?:fonts/(?:Sebenta-Medium\\.woff2|font_4\\.ttf)|media/cierre-28e\\.mp3|favicon\\.ico|sw\\.js)$).+)",
      "destination": "/",
      "permanent": false
    }
  ]
}
